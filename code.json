"/** GA YouTube Uploader - Golden Arch (@GoldenArch-kts)\n *  Doc queue.json tren GitHub, tu dang video moi len kenh YouTube.\n *  Claude cap nhat queue; script chay moi gio.\n */\nvar BASE = 'https://raw.githubusercontent.com/truongsinh92-ai/ga-domain-intel/ga-media/';\n\nfunction processQueue() {\n  var props = PropertiesService.getScriptProperties();\n  var done = JSON.parse(props.getProperty('done') || '{}');\n  var q = JSON.parse(UrlFetchApp.fetch(BASE + 'queue.json?t=' + Date.now()).getContentText());\n  var log = [];\n  q.videos.forEach(function (v) {\n    if (done[v.id] || v.already_uploaded) return;\n    if (v.publish_after && new Date(v.publish_after) > new Date()) return;\n    try {\n      var blob = UrlFetchApp.fetch(BASE + v.file).getBlob().setName(v.id + '.mp4');\n      var res = YouTube.Videos.insert({\n        snippet: { title: v.title, description: v.description || '', tags: v.tags || [], categoryId: v.categoryId || '26', defaultLanguage: 'vi' },\n        status: { privacyStatus: v.privacy || 'public', selfDeclaredMadeForKids: false }\n      }, 'snippet,status', blob);\n      var info = { videoId: res.id, at: new Date().toISOString(), status: res.status.privacyStatus };\n      if (v.thumbnail) {\n        try {\n          YouTube.Thumbnails.set(res.id, UrlFetchApp.fetch(BASE + v.thumbnail).getBlob());\n          info.thumb = 'ok';\n        } catch (e) { info.thumb = String(e); }\n      }\n      done[v.id] = info;\n      log.push(v.id + ' -> ' + res.id);\n    } catch (e) {\n      log.push(v.id + ' ERROR ' + e);\n      props.setProperty('lastError', new Date().toISOString() + ' ' + v.id + ' ' + e);\n    }\n  });\n  props.setProperty('done', JSON.stringify(done));\n  props.setProperty('lastRun', new Date().toISOString() + ' ' + (log.join(' | ') || 'no new'));\n  Logger.log(log.join('\\n') || 'no new');\n  return done;\n}\n\n/** Chay 1 lan: cap quyen + tao lich chay moi gio */\nfunction setup() {\n  ScriptApp.getProjectTriggers().forEach(function (t) { ScriptApp.deleteTrigger(t); });\n  ScriptApp.newTrigger('processQueue').timeBased().everyHours(1).create();\n  var ch = YouTube.Channels.list('snippet', { mine: true });\n  var name = ch.items && ch.items.length ? ch.items[0].snippet.title + ' (' + ch.items[0].id + ')' : 'none';\n  PropertiesService.getScriptProperties().setProperty('channel', name);\n  Logger.log('Channel: ' + name);\n  return name;\n}\n\n/** Web app: xem trang thai */\nfunction doGet() {\n  var p = PropertiesService.getScriptProperties().getProperties();\n  return ContentService.createTextOutput(JSON.stringify(p, null, 2)).setMimeType(ContentService.MimeType.JSON);\n}\n"
